# The host tools do not use OpenSSL. TOOLS_KWBIMAGE selects TOOLS_LIBCRYPTO,
# so both are off.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set

# EFI capsules are not used, so the mkeficapsule host tool and its GnuTLS
# dependency are not needed.
# CONFIG_TOOLS_MKEFICAPSULE is not set

# The environment is the compiled-in default; the boot command and the load
# addresses are part of the U-Boot build. The env file comes from the wrapper
# through the /src bind mount, so the cached source stays untouched.
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_SOURCE_FILE="riscv-emulator"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="/src/configs/riscv-emulator.env"

# The emulator has I, M, A, C, Zicsr, Zifencei and Zicntr. U-Boot uses the
# minimal set: I, M, A, Zicsr and Zifencei. C, F and D are off.
#
# A is required: arch/riscv/cpu/start.S uses amoswap.w for the hart lottery
# and the available-harts lock. CONFIG_RISCV_ISA_A adds the a extension to
# -march in arch/riscv/Makefile.
CONFIG_RISCV_ISA_A=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_F is not set
# CONFIG_RISCV_ISA_D is not set

# The early debug UART writes to the emulator's 16550 at 0x10000000 before
# the driver model serial is up. The S-mode default is the SBI console, so
# the ns16550 debug UART is selected explicitly.
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_NS16550=y
# CONFIG_DEBUG_SBI_CONSOLE is not set
CONFIG_DEBUG_UART_BASE=0x10000000
CONFIG_DEBUG_UART_CLOCK=16777216
CONFIG_DEBUG_UART_SHIFT=0
CONFIG_DEBUG_UART_ANNOUNCE=y
